{
  "manifest_version": 3,
  "name": "Tabs minutes comparison",
  "version": "0.3.0",
  "description": "Compare TabsNBA minutes and stat projections with your prop model while browsing Projections or Props.",
  "permissions": ["storage"],
  "host_permissions": ["https://app.tabsnba.com/*", "https://cktest2.streamlit.app/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Use this TabsNBA tab for minutes comparison"},
  "content_scripts": [
    {"matches": ["https://app.tabsnba.com/projections*"], "js": ["reader.js"], "run_at": "document_idle"},
    {"matches": ["https://cktest2.streamlit.app/*"], "js": ["relay.js"], "run_at": "document_idle", "all_frames": true}
  ]
}
